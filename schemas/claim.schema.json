{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civics.egohygiene.io/schemas/claim.schema.json",
  "title": "Civics claim",
  "description": "A factual, interpretive, or predictive statement. Every claim requires evidence references; interpretations and predictions also require a transparent method and limitations.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "nature",
    "claimType",
    "subjectIds",
    "topicIds",
    "statement",
    "status",
    "evidenceReferences",
    "confidence",
    "temporalScope",
    "interpretation",
    "provenance",
    "freshness",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "kind": {
      "const": "claim"
    },
    "nature": {
      "type": "string",
      "enum": [
        "factual",
        "interpretive",
        "predictive"
      ]
    },
    "claimType": {
      "type": "string",
      "enum": [
        "identity",
        "stated_position",
        "demonstrated_priority",
        "record_summary",
        "ideology",
        "behavioral_pattern",
        "consistency",
        "contradiction",
        "likely_policy_direction",
        "tradeoff",
        "potential_impact",
        "office_authority",
        "uncertainty",
        "other"
      ]
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      },
      "uniqueItems": true
    },
    "topicIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      },
      "uniqueItems": true
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "partially_supported",
        "conflicting",
        "insufficient_evidence",
        "withdrawn"
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "temporalScope": {
      "$ref": "#/$defs/temporalScope"
    },
    "interpretation": {
      "oneOf": [
        {
          "$ref": "#/$defs/interpretation"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nature": {
            "const": "factual"
          }
        },
        "required": [
          "nature"
        ]
      },
      "then": {
        "properties": {
          "interpretation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nature": {
            "enum": [
              "interpretive",
              "predictive"
            ]
          }
        },
        "required": [
          "nature"
        ]
      },
      "then": {
        "properties": {
          "interpretation": {
            "$ref": "#/$defs/interpretation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nature": {
            "const": "predictive"
          }
        },
        "required": [
          "nature"
        ]
      },
      "then": {
        "properties": {
          "interpretation": {
            "properties": {
              "assumptions": {
                "minItems": 1
              },
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claimType": {
            "const": "contradiction"
          }
        },
        "required": [
          "claimType"
        ]
      },
      "then": {
        "properties": {
          "evidenceReferences": {
            "minItems": 2
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "required": [
        "evidenceId",
        "relationship",
        "note"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "common.schema.json#/$defs/entityId"
        },
        "relationship": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "contextualizes"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": [
        "label",
        "score",
        "rationale"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "temporalScope": {
      "type": "object",
      "required": [
        "observedFrom",
        "observedThrough",
        "asOf"
      ],
      "properties": {
        "observedFrom": {
          "$ref": "common.schema.json#/$defs/nullableTimestamp"
        },
        "observedThrough": {
          "$ref": "common.schema.json#/$defs/nullableTimestamp"
        },
        "asOf": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "required": [
        "method",
        "assumptions",
        "alternativeExplanations",
        "limitations"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "alternativeExplanations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
