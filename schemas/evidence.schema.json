{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civics.egohygiene.io/schemas/evidence.schema.json",
  "title": "Civics evidence",
  "description": "A source-grounded observation used to support, contradict, or contextualize claims.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "sourceId",
    "sourceRecordId",
    "evidenceType",
    "subjectIds",
    "relatedEntityIds",
    "topicIds",
    "label",
    "content",
    "stance",
    "occurredAt",
    "publishedAt",
    "retrievedAt",
    "provenance",
    "freshness",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "kind": {
      "const": "evidence"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "sourceRecordId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "candidate_statement",
        "platform_position",
        "legislative_vote",
        "bill_sponsorship",
        "bill_action",
        "executive_action",
        "office_history",
        "election_record",
        "campaign_finance",
        "endorsement",
        "public_record",
        "publication",
        "other"
      ]
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      },
      "uniqueItems": true
    },
    "relatedEntityIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      },
      "uniqueItems": true
    },
    "topicIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityId"
      },
      "uniqueItems": true
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "stance": {
      "type": "string",
      "enum": [
        "support",
        "oppose",
        "mixed",
        "neutral",
        "not_applicable",
        "unknown"
      ]
    },
    "occurredAt": {
      "$ref": "common.schema.json#/$defs/nullableTimestamp"
    },
    "publishedAt": {
      "$ref": "common.schema.json#/$defs/nullableTimestamp"
    },
    "retrievedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "sourceUrl",
        "locator",
        "excerpt",
        "structuredValue",
        "contentHash"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "object",
          "required": [
            "page",
            "section",
            "paragraph",
            "recordPath"
          ],
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "section": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            },
            "paragraph": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "recordPath": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          },
          "additionalProperties": false
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "structuredValue": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "contentHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
